# Copy this file to backend/.env on EACH machine that runs the backend — your local dev
# machine AND the production server separately. This file is gitignored and never deployed
# automatically; docker-compose.yml's `backend` service loads backend/.env from wherever
# it's run, so the production server needs its own copy of this file with real values,
# maintained independently from your local one.
#
# Values shown for optional keys are the defaults the code uses when the key is unset.

# ── Database (PostgreSQL — NOT MySQL) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password   # REQUIRED — the backend refuses to start without it
DB_NAME=pmo_tracker

# ── Server ────────────────────────────────────────────────────────────────
PORT=3001
# Interface to bind. 127.0.0.1 locally; docker-compose.yml sets 0.0.0.0 inside the container.
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ENABLE_CRON_JOBS=true
UPLOAD_DIR=./uploads

# ── Jira (OAuth 2.0 / 3LO only — API token auth is blocked at the org level) ─
JIRA_API_URL=https://cf2020.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=L1
# Custom field IDs (e.g. customfield_10050) for PM, customer, first-response and resolution SLA
JIRA_PM_FIELD=
JIRA_CUST_FIELD=
JIRA_FR_FIELD=
JIRA_RES_FIELD=
JIRA_OAUTH_CLIENT_ID=PASTE_YOUR_JIRA_OAUTH_CLIENT_ID
JIRA_OAUTH_CLIENT_SECRET=PASTE_YOUR_JIRA_OAUTH_CLIENT_SECRET
JIRA_OAUTH_REDIRECT_URI=http://localhost:3001/api/jira/oauth/callback

# ── Microsoft Graph — Email/Call Hygiene + call transcript grading ───────────
# App registration needs: Mail.Read, Calendars.Read, User.Read.All,
# OnlineMeetingTranscript.Read.All (all Application permissions, admin-consented).
# Also requires tenant-level Teams Admin Center settings (Meetings > Meeting settings >
# Transcript API access): "Microsoft Graph access" AND "Include speaker attribution"
# both On — without these, transcript grading fails even with correct app permissions.
MS_GRAPH_TENANT_ID=PASTE_YOUR_MS_GRAPH_TENANT_ID
MS_GRAPH_CLIENT_ID=PASTE_YOUR_MS_GRAPH_CLIENT_ID
MS_GRAPH_CLIENT_SECRET=PASTE_YOUR_MS_GRAPH_CLIENT_SECRET

# ── Microsoft — separate app registration: SSO + Mail.Send for alerts ───────
MICROSOFT_CLIENT_ID=PASTE_YOUR_MICROSOFT_CLIENT_ID
MICROSOFT_CLIENT_SECRET=PASTE_YOUR_MICROSOFT_CLIENT_SECRET
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/auth/microsoft/callback
# Optional override for the alert-email app; falls back to MICROSOFT_CLIENT_ID/SECRET.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Alert emails (sent via Microsoft Graph Mail.Send) ───────────────────────
# Sending mailbox. Unset falls back to a hardcoded default in emailService.ts.
ALERT_FROM_EMAIL=
# While set, 45-minute SLA breach alerts go only to this address. Remove to go live.
SLA_BREACH_ALERT_TEST_RECIPIENT=

# ── SharePoint — Migration Projects Tracker sync ────────────────────────────
# Optional app override; falls back to the MICROSOFT_* app above.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=
SHAREPOINT_ORIGIN=https://cloudfuzecom.sharepoint.com
# Site path and list names default to the values in sharepointSyncService.ts when unset.
SHAREPOINT_SITE_PATH=
SHAREPOINT_LIST_NAME=
SHAREPOINT_LIST_URL_NAME=
# Comma-separated leading column order for the imported view; unset uses the built-in order.
# Keep it commented out unless you set a value: an empty value means "no leading columns".
# SHAREPOINT_COLUMN_ORDER=
SHAREPOINT_TIMEZONE=Asia/Kolkata

# ── OpenAI — call transcript grading + email thread classification ──────────
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# Key for the legacy aiService.ts features; unset disables them.
AI_API_KEY=

# ── Anthropic — self-heal incident diagnosis (backend/src/services/selfHealService.ts) ──
# Optional. Without it, crashes/5xx errors are still captured into self_heal_incidents,
# just never diagnosed -- the 30-min cron and the admin "diagnose now" button both no-op
# cleanly. Code bugs become fix PRs (see SELF_HEAL_* below) that a human merges; nothing is deployed automatically.
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5
# Self-heal fix PRs (optional) — owner/repo + fine-grained PAT: Contents read&write, Pull requests read
SELF_HEAL_GITHUB_REPO=
SELF_HEAL_GITHUB_TOKEN=PASTE_YOUR_GITHUB_TOKEN
SELF_HEAL_MAX_FIX_PRS_PER_DAY=3

# ── External integrations ───────────────────────────────────────────────────
# Shared secret other apps send as X-API-Key to /api/external/*. Generate: openssl rand -hex 32
EXTERNAL_API_KEY=
# Optional: POSTed to (with EXTERNAL_API_KEY) when a project's phase moves to DELTA. Unset = no-op.
EXTERNAL_PHASE_WEBHOOK_URL=

# ── Neutara Ticketing (NTA) — internal ticketing tool integration ───────────
NTA_API_KEY=PASTE_YOUR_NTA_API_KEY
NTA_API_URL=https://neutaraticketing.cftools.live/api

# ── Not read by current code ────────────────────────────────────────────────
# Kept for reference only; nothing in backend/src reads these, so setting them has no effect.
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# SENDGRID_API_KEY=
# SENDGRID_WEBHOOK_ENABLED=false
# SENDGRID_WEBHOOK_SECRET=
# DEAL_DESK_EMAIL=
# HUBSPOT_ACCESS_TOKEN=
# DOCS_API_KEY=
# DOCS_API_URL=
