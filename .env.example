# ═══════════════════════════════════════════════════════════════════
#  PMO TRACKER — DEPLOYMENT CONFIGURATION
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in ALL values marked with  <-- REQUIRED
#  3. Run:              docker compose up -d --build
#
#  The app will be available at https://SERVER_IP (via nginx on port 8091)
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
# Your server's public domain name (must match your SSL certificate)
# Examples:
#   SERVER_IP=203.0.113.50
#   SERVER_IP=neutarapm.cftools.live
SERVER_IP=YOUR_DOMAIN_OR_IP   # <-- REQUIRED

# ── Database ─────────────────────────────────────────────────────────
DB_USER=pmo_user
DB_PASSWORD=change_this_to_a_strong_password   # <-- REQUIRED
DB_NAME=pmo_tracker

# ── Cron Jobs ────────────────────────────────────────────────────────
ENABLE_CRON_JOBS=true

# ── Server Alerts — Microsoft Graph API ──────────────────────────────
# The licensed Microsoft 365 mailbox that sends alert emails.
# No password needed — uses the Azure AD app credentials below.
ALERT_FROM_EMAIL=your.email@yourdomain.com   # <-- REQUIRED

# ── Microsoft Azure AD App ────────────────────────────────────────────
# Used for both Microsoft SSO login AND Graph API email sending.
# Register an app at https://portal.azure.com → Azure Active Directory
#   → App registrations → New registration
# Required API permissions (Application, NOT Delegated):
#   - Microsoft Graph → Mail.Send
# Grant admin consent after adding the permission.
MICROSOFT_CLIENT_ID=your-azure-app-client-id       # <-- REQUIRED
MICROSOFT_CLIENT_SECRET=your-azure-app-secret      # <-- REQUIRED
MICROSOFT_TENANT_ID=common
