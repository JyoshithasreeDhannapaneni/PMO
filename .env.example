# ═══════════════════════════════════════════════════════════════════
#  PMO TRACKER — DEPLOYMENT CONFIGURATION
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values below
#  3. Run:              docker compose up -d --build
#
#  The app will be available at http://SERVER_IP
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
# Your server's public IP address or domain name
# Examples:
#   SERVER_IP=203.0.113.50
#   SERVER_IP=app.yourdomain.com
SERVER_IP=YOUR_SERVER_IP

# ── Database ─────────────────────────────────────────────────────────
DB_USER=pmo_user
DB_PASSWORD=change_this_to_a_strong_password
DB_NAME=pmo_tracker

# ── Cron Jobs ────────────────────────────────────────────────────────
ENABLE_CRON_JOBS=true

# ── Email / SMTP (optional — for notifications) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pmo-tracker.com

# ── Microsoft SSO (optional — for Azure AD login) ─────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
