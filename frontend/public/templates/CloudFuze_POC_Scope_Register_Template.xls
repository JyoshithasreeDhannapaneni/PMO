<Worksheet ss:Name="POC Scope Register">
<Table ss:DefaultRowHeight="18">
<Column ss:Width="30"/><Column ss:Width="220"/><Column ss:Width="100"/><Column ss:Width="260"/><Column ss:Width="130"/>
<Row ss:Height="28"><Cell ss:StyleID="TT" ss:MergeAcross="4"><Data ss:Type="String">CloudFuze  |  POC Scope, Testing &amp; Customisation Register</Data></Cell></Row>
<Row ss:Height="16"><Cell ss:StyleID="ST" ss:MergeAcross="4"><Data ss:Type="String">Complete this sheet for every POC. Fill all sections, then upload the completed file to the POC project in the PMO system.</Data></Cell></Row>
<Row ss:Height="8"><Cell ss:StyleID="SP" ss:MergeAcross="4"><Data ss:Type="String"></Data></Cell></Row>
<Row ss:Height="18"><Cell ss:StyleID="ML"><Data ss:Type="String">Account Name</Data></Cell><Cell ss:StyleID="MV" ss:MergeAcross="1"><Data ss:Type="String">Enter account / company name</Data></Cell><Cell ss:StyleID="ML"><Data ss:Type="String">POC Reference ID</Data></Cell><Cell ss:StyleID="MV"><Data ss:Type="String">Auto-assigned on upload</Data></Cell></Row>
