# Copy to frontend/.env.local for local dev. NEXT_PUBLIC_* values are baked in at build
# time (`npm run build` / docker build), so changing them needs a rebuild.
# Values shown are the defaults the code uses when the key is unset.

# Backend API base URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# Backend URL for Next.js server-side rewrites (next.config.js); docker-compose sets it.
BACKEND_URL=http://localhost:3001

# Hotjar site ID; unset disables Hotjar
NEXT_PUBLIC_HOTJAR_ID=

# Jira site used for ticket links on the Manager Dashboard
NEXT_PUBLIC_JIRA_BASE_URL=https://cf2020.atlassian.net

# SharePoint REST URL an admin opens to save list attachments for "Import SOW attachments"
NEXT_PUBLIC_SHAREPOINT_ATTACHMENTS_URL=https://cloudfuzecom.sharepoint.com/sites/MigrationPractice/_api/web/lists/getbytitle('Migration%20Projects%20Tracker')/items?$select=Id&$expand=AttachmentFiles&$top=5000
