[Unit]
Description=PMO Tracker frontend (Next.js)
After=network.target pmo-backend.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/root/PMO/frontend
# Runs the npm "start" script (next start -H 127.0.0.1 as of 2026-09-23's loopback-binding
# hardening) rather than calling next directly, so this always tracks whatever that script
# says without the unit needing to change alongside it.
ExecStart=/usr/bin/npm start
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
